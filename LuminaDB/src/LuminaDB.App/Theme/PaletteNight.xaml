<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- NIGHT: the Ledger colours for Settings › Dark theme. Warm charcoal paper, light ink. Every key in Palette.xaml
         has its match here; text pairs keep at least 4.5:1. -->
    <Color x:Key="PaperColor">#1E1C18</Color>
    <Color x:Key="InkColor">#ECE5D5</Color>

    <SolidColorBrush x:Key="Paper" Color="#1E1C18" po:Freeze="True"/>
    <SolidColorBrush x:Key="Paper2" Color="#27241F" po:Freeze="True"/>
    <SolidColorBrush x:Key="Paper3" Color="#171512" po:Freeze="True"/>
    <SolidColorBrush x:Key="Ink" Color="#ECE5D5" po:Freeze="True"/>
    <SolidColorBrush x:Key="Ink2" Color="#C9C0AD" po:Freeze="True"/>
    <SolidColorBrush x:Key="Ink3" Color="#A39A88" po:Freeze="True"/>
    <SolidColorBrush x:Key="Rule" Color="#3A352D" po:Freeze="True"/>
    <SolidColorBrush x:Key="RuleStrong" Color="#5A5345" po:Freeze="True"/>
    <SolidColorBrush x:Key="Blue" Color="#8FA6FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="BlueSoft" Color="#26304F" po:Freeze="True"/>
    <SolidColorBrush x:Key="BlueTint" Color="#1F8FA6FF" po:Freeze="True"/>
    <!-- selected grid rows: clearly blue, with light text (Ink on it is about 7:1) -->
    <SolidColorBrush x:Key="BlueSelect" Color="#34447A" po:Freeze="True"/>
    <SolidColorBrush x:Key="BlueSelectRule" Color="#6077C8" po:Freeze="True"/>
    <SolidColorBrush x:Key="Red" Color="#EE8A72" po:Freeze="True"/>
    <SolidColorBrush x:Key="RedSoft" Color="#3E2019" po:Freeze="True"/>
    <SolidColorBrush x:Key="Green" Color="#8CCB98" po:Freeze="True"/>
    <SolidColorBrush x:Key="GreenSoft" Color="#1E3322" po:Freeze="True"/>
    <SolidColorBrush x:Key="Amber" Color="#E6B45E" po:Freeze="True"/>
    <SolidColorBrush x:Key="AmberSoft" Color="#3B2F18" po:Freeze="True"/>
    <SolidColorBrush x:Key="OverlayInk" Color="#B3000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="White" Color="#FFFFFF" po:Freeze="True"/>

    <!-- binder tab colours, cycled -->
    <SolidColorBrush x:Key="Tab1" Color="#4A4232" po:Freeze="True"/>
    <SolidColorBrush x:Key="Tab2" Color="#333C52" po:Freeze="True"/>
    <SolidColorBrush x:Key="Tab3" Color="#50372F" po:Freeze="True"/>
    <SolidColorBrush x:Key="Tab4" Color="#35442F" po:Freeze="True"/>
    <SolidColorBrush x:Key="Tab5" Color="#423C33" po:Freeze="True"/>


    <!-- fills that carry White text (Run, Stop, Delete): the same as Blue and Red here; darker than them at night -->
    <SolidColorBrush x:Key="BlueFill" Color="#3550D0" po:Freeze="True"/>
    <SolidColorBrush x:Key="RedFill" Color="#B5432A" po:Freeze="True"/>
    <!-- plain white cards (diagram tables, the PHP info pane) -->
    <SolidColorBrush x:Key="PaperCard" Color="#2A2721" po:Freeze="True"/>
    <!-- the window frame (title strip and tab rail): dark in both themes, under its light caption text -->
    <!-- the hard offset shadow under buttons and menus -->
    <SolidColorBrush x:Key="Shadow" Color="#4A4438" po:Freeze="True"/>
    <SolidColorBrush x:Key="Chrome" Color="#0F0E0C" po:Freeze="True"/>

    <!-- SQL colouring in the editors -->
    <SolidColorBrush x:Key="SyntaxComment" Color="#9A917F" po:Freeze="True"/>
    <SolidColorBrush x:Key="SyntaxString" Color="#A9CF8E" po:Freeze="True"/>
    <SolidColorBrush x:Key="SyntaxName" Color="#ECE5D5" po:Freeze="True"/>
    <SolidColorBrush x:Key="SyntaxNumber" Color="#D7A0E8" po:Freeze="True"/>
    <SolidColorBrush x:Key="SyntaxKeyword" Color="#9DB0FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="SyntaxFunction" Color="#B8C4FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="SyntaxVariable" Color="#E6B45E" po:Freeze="True"/>

    <!-- Scalloped "torn paper" top edge for receipts and confirmation slips (Paper3). -->
    <!-- Scalloped "torn paper" top edge for receipts and confirmation slips. -->
    <DrawingBrush x:Key="TearEdge" TileMode="Tile" Viewport="0,0,12,6" ViewportUnits="Absolute" Stretch="None" po:Freeze="True">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#171512" Geometry="M0,0 A6,4.5 0 0 0 12,0 L12,6 L0,6 Z"/>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- dashed rules: Dash for lines, NullDash for the box around NULL in result grids (RuleStrong) -->
    <DrawingBrush x:Key="Dash" Viewport="0,0,6,1" ViewportUnits="Absolute" TileMode="Tile" po:Freeze="True">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#5A5345" Geometry="M0,0 H3 V1 H0 Z"/>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="NullDash" Viewport="0,0,4,4" ViewportUnits="Absolute" TileMode="Tile" po:Freeze="True">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#5A5345" Geometry="M0,0 H2 V2 H0 Z M2,2 H4 V4 H2 Z"/>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
