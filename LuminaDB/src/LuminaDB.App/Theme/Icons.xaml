<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <!-- Our own small icon set, drawn on a 16×16 grid (Segoe MDL2 isn't on Windows 7). Stroke icons. -->
    <Geometry x:Key="IconCopy" po:Freeze="True">M5,5 H13 V14 H5 Z M3,11 V2 H10</Geometry>
    <Geometry x:Key="IconRefresh" po:Freeze="True">M13,8 A5,5 0 1 1 11.5,4.5 M11.5,1.5 V4.5 H8.5</Geometry>
    <Geometry x:Key="IconPlus" po:Freeze="True">M8,3 V13 M3,8 H13</Geometry>
    <Geometry x:Key="IconPlay" po:Freeze="True">M4,2.5 L13,8 L4,13.5 Z</Geometry>
    <Geometry x:Key="IconStop" po:Freeze="True">M3.5,3.5 H12.5 V12.5 H3.5 Z</Geometry>
    <Geometry x:Key="IconFolder" po:Freeze="True">M1.5,3.5 H6 L7.5,5 H14.5 V13 H1.5 Z</Geometry>
    <Geometry x:Key="IconArrow" po:Freeze="True">M29,8 C20,2 10,14 2,8 M2,8 L8,4 M2,8 L8,12</Geometry>
    <Geometry x:Key="IconUndo" po:Freeze="True">M5,3.5 L1.5,7 L5,10.5 M1.5,7 H10 A3.5,3.5 0 0 1 10,14 H6</Geometry>
    <Geometry x:Key="IconDown" po:Freeze="True">M4,6 L8,10 L12,6</Geometry>
    <Geometry x:Key="IconTidy" po:Freeze="True">M2,3.5 H14 M5,8 H14 M5,12.5 H11</Geometry>
    <Geometry x:Key="IconPlayAll" po:Freeze="True">M2,2.5 L8,8 L2,13.5 Z M8,2.5 L14,8 L8,13.5 Z</Geometry>
    <Geometry x:Key="IconExpand" po:Freeze="True">M9.5,2.5 H13.5 V6.5 M13.5,2.5 L9,7 M6.5,13.5 H2.5 V9.5 M2.5,13.5 L7,9</Geometry>
    <Geometry x:Key="IconCollapse" po:Freeze="True">M13.5,2.5 L9.5,6.5 M9.5,3 V6.5 H13 M2.5,13.5 L6.5,9.5 M3,9.5 H6.5 V13</Geometry>
    <Geometry x:Key="IconPanelLeft" po:Freeze="True">M2.5,2.5 H13.5 V13.5 H2.5 Z M6,2.5 V13.5</Geometry>
    <Geometry x:Key="IconPanelRight" po:Freeze="True">M2.5,2.5 H13.5 V13.5 H2.5 Z M10,2.5 V13.5</Geometry>

    <Style x:Key="Icon" TargetType="Path">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="Stroke" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
</ResourceDictionary>
