<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Ledger versions of the controls the Notebook needs: a switch, paper menus, a ruled data grid.
         Flat fills only (no effects, no gradients) so they stay fast on old lab GPUs. -->

    <!-- ============================================================ switch (CheckBox) -->
    <Style x:Key="LedgerSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusNone}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="30" Height="16" VerticalAlignment="Center">
                            <Border x:Name="track" CornerRadius="8" Background="{StaticResource RuleStrong}"/>
                            <Ellipse x:Name="knob" Width="12" Height="12" Fill="{StaticResource Paper3}" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        </Grid>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{StaticResource Ink}"/>
                            <Setter TargetName="knob" Property="Margin" Value="16,0,0,0"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Blue}"/>
                            <Setter TargetName="track" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ paper menus -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource Paper3}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Ink}"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Grid Margin="0,0,3,3">
                        <Border Background="{StaticResource Shadow}" CornerRadius="3" Margin="3,3,-3,-3"/>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="3" Padding="0,4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="440" Focusable="False">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="row" Background="Transparent" Padding="14,5,18,5" MinWidth="200">
                            <DockPanel>
                                <Path x:Name="arrow" DockPanel.Dock="Right" Width="5" Height="9" Margin="14,0,0,0" Stretch="Uniform" Visibility="Collapsed"
                                      Stroke="{StaticResource Ink3}" StrokeThickness="1.5" Data="M0,0 L4,4.5 L0,9" VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right" Text="{TemplateBinding InputGestureText}" FontFamily="{StaticResource FontMono}" FontSize="11"
                                           Foreground="{StaticResource Ink3}" Margin="18,0,0,0" VerticalAlignment="Center"/>
                                <Path x:Name="tick" DockPanel.Dock="Left" Width="10" Height="10" Margin="0,0,8,0" Stretch="Uniform" Visibility="Hidden"
                                      Stroke="{StaticResource Ink}" StrokeThickness="1.8" Data="M0,5 L4,9 L10,1" VerticalAlignment="Center"/>
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <!-- submenus (Examples and Snippets under More, "Delete one of yours" under Snippets) open to the side -->
                        <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-4" VerticalOffset="-6" AllowsTransparency="True" Focusable="False"
                               PopupAnimation="None" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Grid Margin="0,0,3,3" TextElement.FontFamily="{StaticResource FontBody}" TextElement.FontSize="13" TextElement.Foreground="{StaticResource Ink}">
                                <Border Background="{StaticResource Shadow}" CornerRadius="3" Margin="3,3,-3,-3"/>
                                <Border Background="{StaticResource Paper3}" BorderBrush="{StaticResource Ink}" BorderThickness="1.5" CornerRadius="3" Padding="0,4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="440" Focusable="False">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="row" Property="Background" Value="{StaticResource BlueSoft}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Ink3}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator" x:Key="{x:Static MenuItem.SeparatorStyleKey}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{StaticResource Rule}" Margin="10,4"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ ruled data grid -->
    <Style x:Key="LedgerGridHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Paper3}"/>
        <Setter Property="Foreground" Value="{StaticResource Ink3}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontMonoMedium}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,2" Padding="10,6,10,5">
                            <ContentPresenter VerticalAlignment="Bottom"/>
                        </Border>
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="6" Cursor="SizeWE">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent" Padding="2,6"><Border Width="1" Background="{StaticResource Rule}"/></Border>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LedgerGridCell" TargetType="DataGridCell">
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusNone}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border x:Name="cell" Background="Transparent" Padding="{TemplateBinding Padding}" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="cell" Property="Background" Value="{StaticResource BlueSelect}"/>
                            <Setter TargetName="cell" Property="BorderBrush" Value="{StaticResource BlueSelectRule}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- the system theme turns selected text white (HighlightText); keep it dark on the blue so it stays readable -->
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LedgerGridRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BlueTint}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LedgerGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource Paper3}"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="RowHeight" Value="24"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserReorderColumns" Value="True"/>
        <Setter Property="CanUserResizeColumns" Value="True"/>
        <Setter Property="CanUserSortColumns" Value="True"/>
        <Setter Property="SelectionUnit" Value="CellOrRowHeader"/>
        <Setter Property="SelectionMode" Value="Extended"/>
        <Setter Property="ClipboardCopyMode" Value="IncludeHeader"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="EnableColumnVirtualization" Value="True"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Item"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource LedgerGridHeader}"/>
        <Setter Property="CellStyle" Value="{StaticResource LedgerGridCell}"/>
        <Setter Property="RowStyle" Value="{StaticResource LedgerGridRow}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Rule}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusNone}"/>
    </Style>

    <!-- ============================================================ tick box (table cells, forms) -->
    <Style x:Key="LedgerCheck" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusNone}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box" Width="15" Height="15" CornerRadius="2" BorderThickness="1.5" BorderBrush="{StaticResource RuleStrong}" Background="{StaticResource Paper3}" VerticalAlignment="Center">
                            <Path x:Name="tick" Data="M1.5,5.5 L4.3,8.3 L9.5,2.3" Stroke="{StaticResource Paper3}" StrokeThickness="2" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Border>
                        <ContentPresenter x:Name="content" Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="content" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource Ink}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Ink}"/>
                            <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Ink}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Blue}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ drop-down (ComboBox), editable or not -->
    <Style x:Key="LedgerComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="ClickMode" Value="Press"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Data="M0,0 L4,4 L8,0" Stroke="{StaticResource Ink3}" StrokeThickness="1.5" Width="8" Height="5"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Padding" Value="9,4"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusNone}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource BlueSoft}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Background" Value="{StaticResource Paper}"/>
        <Setter Property="BorderBrush" Value="{StaticResource RuleStrong}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="7,4,22,4"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusNone}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"/>
                        <ToggleButton x:Name="toggle" Style="{StaticResource LedgerComboToggle}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter x:Name="content" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                        <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Margin="1.5,1.5,20,1.5" Padding="5,3,2,3" BorderThickness="0" Background="Transparent"
                                 FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" VerticalContentAlignment="Center"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="False" Focusable="False" PopupAnimation="None"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Background="{StaticResource Paper3}" BorderBrush="{StaticResource Ink}" BorderThickness="1.5"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="content" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="toggle" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="toggle" Property="Width" Value="22"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Ink3}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Blue}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
