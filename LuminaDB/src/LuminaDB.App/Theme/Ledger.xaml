<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- =================================================================
         LEDGER design tokens (SPEC §7). Warm paper, ink, one blue for action,
         vermillion for corrections/danger. No gradients, blur or drop-shadow
         effects: old integrated GPUs stay fast.
         ================================================================= -->
    <Color x:Key="PaperColor">#F2EDE1</Color>
    <Color x:Key="InkColor">#1C1A16</Color>

    <SolidColorBrush x:Key="Paper" Color="#F2EDE1" po:Freeze="True"/>
    <SolidColorBrush x:Key="Paper2" Color="#EAE3D3" po:Freeze="True"/>
    <SolidColorBrush x:Key="Paper3" Color="#FBF8F1" po:Freeze="True"/>
    <SolidColorBrush x:Key="Ink" Color="#1C1A16" po:Freeze="True"/>
    <SolidColorBrush x:Key="Ink2" Color="#4A453B" po:Freeze="True"/>
    <SolidColorBrush x:Key="Ink3" Color="#857D6C" po:Freeze="True"/>
    <SolidColorBrush x:Key="Rule" Color="#D8CFBC" po:Freeze="True"/>
    <SolidColorBrush x:Key="RuleStrong" Color="#BDB29B" po:Freeze="True"/>
    <SolidColorBrush x:Key="Blue" Color="#1F3FBF" po:Freeze="True"/>
    <SolidColorBrush x:Key="BlueSoft" Color="#E1E5F5" po:Freeze="True"/>
    <SolidColorBrush x:Key="BlueTint" Color="#0F1F3FBF" po:Freeze="True"/>
    <SolidColorBrush x:Key="Red" Color="#D83A1E" po:Freeze="True"/>
    <SolidColorBrush x:Key="RedSoft" Color="#F7DDD3" po:Freeze="True"/>
    <SolidColorBrush x:Key="Green" Color="#2F7A45" po:Freeze="True"/>
    <SolidColorBrush x:Key="GreenSoft" Color="#DCEAD9" po:Freeze="True"/>
    <SolidColorBrush x:Key="Amber" Color="#B8730A" po:Freeze="True"/>
    <SolidColorBrush x:Key="AmberSoft" Color="#F4E6C6" po:Freeze="True"/>
    <SolidColorBrush x:Key="OverlayInk" Color="#8C1C1A16" po:Freeze="True"/>
    <SolidColorBrush x:Key="White" Color="#FFFFFF" po:Freeze="True"/>

    <!-- binder tab colours, cycled -->
    <SolidColorBrush x:Key="Tab1" Color="#D9CDB4" po:Freeze="True"/>
    <SolidColorBrush x:Key="Tab2" Color="#CBD3E6" po:Freeze="True"/>
    <SolidColorBrush x:Key="Tab3" Color="#E7C9BE" po:Freeze="True"/>
    <SolidColorBrush x:Key="Tab4" Color="#CFDCC9" po:Freeze="True"/>
    <SolidColorBrush x:Key="Tab5" Color="#DCD6CB" po:Freeze="True"/>

    <!-- Fonts are embedded in the exe (OFL). Works offline on any PC. -->
    <FontFamily x:Key="FontDisplay">pack://application:,,,/LuminaDB;component/Fonts/#Bricolage Grotesque</FontFamily>
    <FontFamily x:Key="FontBody">pack://application:,,,/LuminaDB;component/Fonts/#IBM Plex Sans</FontFamily>
    <FontFamily x:Key="FontMono">pack://application:,,,/LuminaDB;component/Fonts/#IBM Plex Mono</FontFamily>
    <FontFamily x:Key="FontMonoMedium">pack://application:,,,/LuminaDB;component/Fonts/#IBM Plex Mono Medium</FontFamily>
    <FontFamily x:Key="FontNote">pack://application:,,,/LuminaDB;component/Fonts/#Instrument Serif</FontFamily>

    <!-- Scalloped "torn paper" top edge for receipts and confirmation slips. -->
    <DrawingBrush x:Key="TearEdge" TileMode="Tile" Viewport="0,0,12,6" ViewportUnits="Absolute" Stretch="None" po:Freeze="True">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#FBF8F1" Geometry="M0,0 A6,4.5 0 0 0 12,0 L12,6 L0,6 Z"/>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ================================================================= text -->
    <Style x:Key="Eyebrow" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMonoMedium}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{StaticResource Ink3}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>
    <Style x:Key="H3" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Note" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontNote}"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="Foreground" Value="{StaticResource Ink2}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Ink2}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>

    <!-- ================================================================= buttons
         Ink-stamped: a plain ink rectangle offset behind the face (no effects). -->
    <Style x:Key="FocusNone">
        <Setter Property="Control.Template">
            <Setter.Value><ControlTemplate><Rectangle/></ControlTemplate></Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LedgerButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Paper3}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Ink}"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusNone}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="root" Margin="0,0,3,3" SnapsToDevicePixels="True">
                        <Border x:Name="shadow" Background="{StaticResource Ink}" CornerRadius="3" Margin="2,2,-2,-2"/>
                        <Border x:Name="face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.5" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="root" Property="RenderTransform">
                                <Setter.Value><TranslateTransform X="-1" Y="-1"/></Setter.Value>
                            </Setter>
                            <Setter TargetName="shadow" Property="Margin" Value="3,3,-3,-3"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="root" Property="RenderTransform">
                                <Setter.Value><TranslateTransform X="2" Y="2"/></Setter.Value>
                            </Setter>
                            <Setter TargetName="shadow" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="face" Property="BorderBrush" Value="{StaticResource Blue}"/>
                            <Setter TargetName="face" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.45"/>
                            <Setter TargetName="shadow" Property="Visibility" Value="Hidden"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource LedgerButton}"/>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource LedgerButton}">
        <Setter Property="Background" Value="{StaticResource Blue}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Blue}"/>
        <Setter Property="Foreground" Value="{StaticResource White}"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource LedgerButton}">
        <Setter Property="Background" Value="{StaticResource Red}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Red}"/>
        <Setter Property="Foreground" Value="{StaticResource White}"/>
    </Style>

    <Style x:Key="QuietButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource RuleStrong}"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusNone}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1.5" CornerRadius="3" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="face" Property="BorderBrush" Value="{StaticResource Ink}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="face" Property="Background" Value="{StaticResource Paper2}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="face" Property="BorderBrush" Value="{StaticResource Blue}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="face" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A whole row that acts as a button (ledger rows). -->
    <Style x:Key="RowButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusNone}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource BlueTint}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource BlueSoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================= inputs -->
    <Style x:Key="LedgerTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Background" Value="{StaticResource Paper}"/>
        <Setter Property="BorderBrush" Value="{StaticResource RuleStrong}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="CaretBrush" Value="{StaticResource Ink}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Blue}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusNone}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Blue}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource LedgerTextBox}"/>

    <Style TargetType="PasswordBox">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Background" Value="{StaticResource Paper}"/>
        <Setter Property="BorderBrush" Value="{StaticResource RuleStrong}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="CaretBrush" Value="{StaticResource Ink}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusNone}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Blue}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================= scrollbars: thin ink rails -->
    <Style x:Key="ThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="t" Background="{StaticResource RuleStrong}" CornerRadius="3" Margin="2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Background" Value="{StaticResource Ink3}"/></Trigger>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="t" Property="Background" Value="{StaticResource Ink2}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb><Thumb Style="{StaticResource ThumbStyle}"/></Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.Thumb><Thumb Style="{StaticResource ThumbStyle}"/></Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Ink}"/>
        <Setter Property="Foreground" Value="{StaticResource Paper}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>
</ResourceDictionary>
