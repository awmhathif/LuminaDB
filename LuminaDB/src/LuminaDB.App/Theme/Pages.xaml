<ResourceDictionary xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Styles shared by the working pages (Tables, Projects, Mail): toolbar buttons, page chips, index rows, cards. -->
    <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource LedgerButton}">
        <Setter Property="Padding" Value="11,5"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <Style x:Key="ToolPrimary" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <Style x:Key="ToolDanger" TargetType="Button" BasedOn="{StaticResource DangerButton}">
        <Setter Property="Padding" Value="11,5"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <Style x:Key="PageChipButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusNone}"/>
        <Setter Property="Foreground" Value="{StaticResource Ink2}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="2,4,2,5" Margin="0,0,18,0">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Ink}"/>
                            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Blue}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Blue}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Blue}"/>
                            <Setter TargetName="b" Property="Background" Value="{StaticResource BlueSoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IndexButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusNone}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent" Padding="8,4" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource BlueTint}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource BlueSoft}"/>
                        </DataTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource BlueSoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TinyButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Ink3}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusNone}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent" Padding="4,1" CornerRadius="2" BorderThickness="1.5" BorderBrush="Transparent">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Blue}"/>
                            <Setter TargetName="b" Property="Background" Value="{StaticResource BlueSoft}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Blue}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Blue}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SectionHead" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
        <Setter Property="Margin" Value="0,18,0,6"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Paper3}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Rule}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,12,16,14"/>
        <Setter Property="Margin" Value="0,0,14,14"/>
    </Style>
        <!-- segmented choice (Editor | Split | Results, page tabs) and panel toggles: Tag=True marks the chosen one -->
        <Style x:Key="Seg" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Ink2}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusNone}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="2" Padding="{TemplateBinding Padding}" BorderThickness="1.5" BorderBrush="Transparent">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Paper2}"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            </Trigger>
                            <Trigger Property="Tag"><Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value>
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Ink}"/>
                                <Setter Property="Foreground" Value="{StaticResource Paper3}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Blue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Padding" Value="9,3"/>
        </Style>

        <Style x:Key="SegGroup" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Rule}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Background" Value="{StaticResource Paper3}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

</ResourceDictionary>
