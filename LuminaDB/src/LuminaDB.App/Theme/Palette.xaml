<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- LEDGER colours (SPEC §7): warm paper, ink, one blue for action, vermillion for corrections. Every key here
         has a dark match in PaletteNight.xaml; add new colours to both. -->
    <Color x:Key="PaperColor">#F2EDE1</Color>
    <Color x:Key="InkColor">#1C1A16</Color>

    <SolidColorBrush x:Key="Paper" Color="#F2EDE1" po:Freeze="True"/>
    <SolidColorBrush x:Key="Paper2" Color="#EAE3D3" po:Freeze="True"/>
    <SolidColorBrush x:Key="Paper3" Color="#FBF8F1" po:Freeze="True"/>
    <SolidColorBrush x:Key="Ink" Color="#1C1A16" po:Freeze="True"/>
    <SolidColorBrush x:Key="Ink2" Color="#4A453B" po:Freeze="True"/>
    <SolidColorBrush x:Key="Ink3" Color="#625B4D" po:Freeze="True"/>
    <SolidColorBrush x:Key="Rule" Color="#D8CFBC" po:Freeze="True"/>
    <SolidColorBrush x:Key="RuleStrong" Color="#BDB29B" po:Freeze="True"/>
    <SolidColorBrush x:Key="Blue" Color="#1F3FBF" po:Freeze="True"/>
    <SolidColorBrush x:Key="BlueSoft" Color="#E1E5F5" po:Freeze="True"/>
    <SolidColorBrush x:Key="BlueTint" Color="#0F1F3FBF" po:Freeze="True"/>
    <!-- selected grid rows: clearly blue, with dark text (Ink on it is about 13:1) -->
    <SolidColorBrush x:Key="BlueSelect" Color="#C5CEF2" po:Freeze="True"/>
    <SolidColorBrush x:Key="BlueSelectRule" Color="#8E9DE0" po:Freeze="True"/>
    <SolidColorBrush x:Key="Red" Color="#AE2F18" po:Freeze="True"/>
    <SolidColorBrush x:Key="RedSoft" Color="#F7DDD3" po:Freeze="True"/>
    <SolidColorBrush x:Key="Green" Color="#276638" po:Freeze="True"/>
    <SolidColorBrush x:Key="GreenSoft" Color="#DCEAD9" po:Freeze="True"/>
    <SolidColorBrush x:Key="Amber" Color="#835104" po:Freeze="True"/>
    <SolidColorBrush x:Key="AmberSoft" Color="#F4E6C6" po:Freeze="True"/>
    <SolidColorBrush x:Key="OverlayInk" Color="#8C1C1A16" po:Freeze="True"/>
    <SolidColorBrush x:Key="White" Color="#FFFFFF" po:Freeze="True"/>

    <!-- binder tab colours, cycled -->
    <SolidColorBrush x:Key="Tab1" Color="#D9CDB4" po:Freeze="True"/>
    <SolidColorBrush x:Key="Tab2" Color="#CBD3E6" po:Freeze="True"/>
    <SolidColorBrush x:Key="Tab3" Color="#E7C9BE" po:Freeze="True"/>
    <SolidColorBrush x:Key="Tab4" Color="#CFDCC9" po:Freeze="True"/>
    <SolidColorBrush x:Key="Tab5" Color="#DCD6CB" po:Freeze="True"/>


    <!-- fills that carry White text (Run, Stop, Delete): the same as Blue and Red here; darker than them at night -->
    <SolidColorBrush x:Key="BlueFill" Color="#1F3FBF" po:Freeze="True"/>
    <SolidColorBrush x:Key="RedFill" Color="#AE2F18" po:Freeze="True"/>
    <!-- plain white cards (diagram tables, the PHP info pane) -->
    <SolidColorBrush x:Key="PaperCard" Color="#FFFFFF" po:Freeze="True"/>
    <!-- the window frame (title strip and tab rail): dark in both themes, under its light caption text -->
    <!-- the hard offset shadow under buttons and menus -->
    <SolidColorBrush x:Key="Shadow" Color="#1C1A16" po:Freeze="True"/>
    <SolidColorBrush x:Key="Chrome" Color="#1C1A16" po:Freeze="True"/>

    <!-- SQL colouring in the editors -->
    <SolidColorBrush x:Key="SyntaxComment" Color="#625B4D" po:Freeze="True"/>
    <SolidColorBrush x:Key="SyntaxString" Color="#7A4E12" po:Freeze="True"/>
    <SolidColorBrush x:Key="SyntaxName" Color="#1C1A16" po:Freeze="True"/>
    <SolidColorBrush x:Key="SyntaxNumber" Color="#7B2E8E" po:Freeze="True"/>
    <SolidColorBrush x:Key="SyntaxKeyword" Color="#1F3FBF" po:Freeze="True"/>
    <SolidColorBrush x:Key="SyntaxFunction" Color="#2B3F8F" po:Freeze="True"/>
    <SolidColorBrush x:Key="SyntaxVariable" Color="#835104" po:Freeze="True"/>

    <!-- Scalloped "torn paper" top edge for receipts and confirmation slips (Paper3). -->
    <!-- Scalloped "torn paper" top edge for receipts and confirmation slips. -->
    <DrawingBrush x:Key="TearEdge" TileMode="Tile" Viewport="0,0,12,6" ViewportUnits="Absolute" Stretch="None" po:Freeze="True">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#FBF8F1" Geometry="M0,0 A6,4.5 0 0 0 12,0 L12,6 L0,6 Z"/>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- dashed rules: Dash for lines, NullDash for the box around NULL in result grids (RuleStrong) -->
    <DrawingBrush x:Key="Dash" Viewport="0,0,6,1" ViewportUnits="Absolute" TileMode="Tile" po:Freeze="True">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#BDB29B" Geometry="M0,0 H3 V1 H0 Z"/>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="NullDash" Viewport="0,0,4,4" ViewportUnits="Absolute" TileMode="Tile" po:Freeze="True">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#BDB29B" Geometry="M0,0 H2 V2 H0 Z M2,2 H4 V4 H2 Z"/>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
