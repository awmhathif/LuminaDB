<Application x:Class="LuminaDB.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- the colours first: App swaps Palette.xaml for PaletteNight.xaml at start when Settings › Dark theme is on -->
                <ResourceDictionary Source="Theme/Palette.xaml"/>
                <ResourceDictionary Source="Theme/Ledger.xaml"/>
                <ResourceDictionary Source="Theme/Icons.xaml"/>
                <ResourceDictionary Source="Theme/LedgerControls.xaml"/>
                <ResourceDictionary Source="Theme/Pages.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
