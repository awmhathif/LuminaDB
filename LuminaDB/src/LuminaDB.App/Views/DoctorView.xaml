<UserControl x:Class="LuminaDB.App.Views.DoctorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:LuminaDB.App.Controls"
             xmlns:vm="clr-namespace:LuminaDB.App.ViewModels">
    <UserControl.Resources>
        <c:BoolToVisibility x:Key="Vis"/>
        <c:BoolToVisibility x:Key="NotVis" Invert="True"/>
        <c:PaletteBrush x:Key="Fg"/>
        <c:PaletteBrush x:Key="Soft" Mode="soft"/>
        <c:SeverityLabel x:Key="SevLabel"/>

        <!-- the severity chip: OK / LOOK / FIX -->
        <DataTemplate x:Key="Chip" DataType="{x:Type vm:DoctorItem}">
            <Border Background="{Binding Severity, Converter={StaticResource Soft}}" CornerRadius="2" Padding="5,1" VerticalAlignment="Top" MinWidth="38">
                <TextBlock Text="{Binding Severity, Converter={StaticResource SevLabel}}" FontFamily="{StaticResource FontMono}" FontWeight="SemiBold"
                           FontSize="11" Foreground="{Binding Severity, Converter={StaticResource Fg}}" HorizontalAlignment="Center"/>
            </Border>
        </DataTemplate>

        <!-- a stamp pressed onto the paper once a fix worked -->
        <DataTemplate x:Key="FixedStamp">
            <Border BorderBrush="{StaticResource Green}" BorderThickness="2" CornerRadius="3" Padding="7,1" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Border.LayoutTransform><RotateTransform Angle="-4"/></Border.LayoutTransform>
                <TextBlock Text="FIXED" FontFamily="{StaticResource FontMonoMedium}" FontSize="11" Foreground="{StaticResource Green}"/>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="32,26,32,40" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource Eyebrow}" Text="DOCTOR · THE CHECK-UP"/>
            <TextBlock Style="{StaticResource H2}" Text="{Binding Heading}"/>
            <TextBlock Style="{StaticResource Note}" Margin="0,-6,0,16" Text="{Binding RunNote}" TextWrapping="Wrap"/>

            <WrapPanel Margin="0,0,0,22">
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding RunCommand}" Margin="0,0,10,6" AutomationProperties.Name="Check again">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconRefresh}" Width="12" Height="12" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding RunLabel}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QuietButton}" Command="{Binding OpenLogsCommand}" Margin="0,0,10,6" Padding="10,6" AutomationProperties.Name="Open logs">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconFolder}" Width="12" Height="12" Margin="0,0,7,0"/>
                        <TextBlock Text="Open logs"/>
                    </StackPanel>
                </Button>
            </WrapPanel>

            <!-- ======================================================== needs a look -->
            <StackPanel Visibility="{Binding HasProblems, Converter={StaticResource Vis}}">
                <TextBlock Style="{StaticResource Eyebrow}" Text="NEEDS A LOOK" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Problems}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DoctorItem}">
                            <Border Background="{StaticResource Paper3}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="16,12,16,14" Margin="0,0,0,10"
                                    AutomationProperties.Name="{Binding Title}">
                                <DockPanel>
                                    <ContentPresenter DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource Chip}" Margin="0,3,12,0"/>
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Code}" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Ink3}"
                                                       Margin="12,3,0,0" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                            <TextBlock Text="{Binding Title}" FontFamily="{StaticResource FontDisplay}" FontWeight="SemiBold" FontSize="16.5"
                                                       Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Text}" Style="{StaticResource Body}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"/>

                                        <WrapPanel Margin="0,10,0,0" Visibility="{Binding HasFix, Converter={StaticResource Vis}}">
                                            <Button Style="{StaticResource ToolPrimary}" Content="{Binding FixLabel}" AutomationProperties.Name="{Binding FixLabel}"
                                                    Command="{Binding FixCommand}" CommandParameter="{Binding}"/>
                                            <TextBlock Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Ink3}" VerticalAlignment="Center"
                                                       Text="{Binding FixNote}" Visibility="{Binding HasFixNote, Converter={StaticResource Vis}}"/>
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Amber}" Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Text="{Binding Progress}" Visibility="{Binding HasProgress, Converter={StaticResource Vis}}"/>
                                        <TextBlock Style="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Red}" Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Text="{Binding Problem}" Visibility="{Binding HasProblem, Converter={StaticResource Vis}}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding IsFixed, Converter={StaticResource Vis}}">
                                            <ContentPresenter ContentTemplate="{StaticResource FixedStamp}" Content="{Binding}"/>
                                            <TextBlock Style="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Ink2}" Margin="10,2,0,0" Text="{Binding Fixed}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ======================================================== healthy -->
            <StackPanel Visibility="{Binding HasHealthy, Converter={StaticResource Vis}}" Margin="0,12,0,0">
                <TextBlock Style="{StaticResource Eyebrow}" Text="HEALTHY" Margin="0,0,0,4"/>
                <Border Background="{StaticResource Paper3}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="16,4">
                    <ItemsControl ItemsSource="{Binding Healthy}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DoctorItem}">
                                <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <DockPanel>
                                        <ContentPresenter DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource Chip}" Margin="0,2,12,0"/>
                                        <ContentPresenter DockPanel.Dock="Right" ContentTemplate="{StaticResource FixedStamp}" Content="{Binding}" Margin="12,0,0,0"
                                                          Visibility="{Binding IsFixed, Converter={StaticResource Vis}}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Code}" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Ink3}"
                                                   Margin="12,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Text}" Style="{StaticResource Body}" FontSize="12.5" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Fixed}" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Green}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                       Visibility="{Binding IsFixed, Converter={StaticResource Vis}}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <TextBlock Style="{StaticResource Note}" Margin="0,18,0,0" TextWrapping="Wrap"
                       Text="Runs after every start and whenever you open this page. Any fix that touches data backs up every database first."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
