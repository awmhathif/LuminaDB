<UserControl x:Class="LuminaDB.App.Views.ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:LuminaDB.App.Controls"
             xmlns:vm="clr-namespace:LuminaDB.App.ViewModels"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <UserControl.Resources>
        <c:BoolToVisibility x:Key="Vis"/>
        <c:BoolToVisibility x:Key="NotVis" Invert="True"/>
        <c:PaletteBrush x:Key="Fg"/>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="Field" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="220"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="Bar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="{StaticResource Rule}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="CardBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Paper3}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Rule}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="MaxWidth" Value="980"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <DataTemplate x:Key="RewriteItem" DataType="{x:Type vm:RewriteLine}">
            <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1" Padding="0,6">
                <DockPanel>
                    <Border DockPanel.Dock="Left" BorderBrush="{StaticResource Blue}" BorderThickness="1" CornerRadius="2" Padding="5,1" Margin="0,1,12,0" VerticalAlignment="Top" MinWidth="42">
                        <TextBlock Text="{Binding Id}" FontFamily="{StaticResource FontMonoMedium}" FontSize="9.5" Foreground="{StaticResource Blue}" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}" FontSize="13" Text="{Binding Text}" TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource Mono}" FontSize="10.5" Foreground="{StaticResource Ink3}" Text="{Binding CountText}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ProblemItem" DataType="{x:Type vm:ProblemLine}">
            <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1" Padding="0,7" ToolTip="{Binding Server}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Width="86" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Red}" Text="{Binding LineText}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Ink}" Text="{Binding Headline}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Style="{StaticResource Body}" FontSize="12.5" Foreground="{StaticResource Ink2}" Text="{Binding Text}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="32,26,32,40">
            <TextBlock Style="{StaticResource Eyebrow}" Text="IMPORT · FROM XAMPP, WORKBENCH, PHPMYADMIN AND EXCEL"/>
            <TextBlock Style="{StaticResource H2}" Text="Bring work in, take it out."/>
            <TextBlock Style="{StaticResource Note}" Margin="0,-6,0,14" Text="{Binding EngineNote}" TextWrapping="Wrap" MaxWidth="860" HorizontalAlignment="Left"/>

            <ItemsControl ItemsSource="{Binding Pages}" Focusable="False" Margin="0,0,0,18">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PageChip}">
                        <Button Style="{StaticResource PageChipButton}" Content="{Binding Label}" AutomationProperties.Name="{Binding Label}"
                                Command="{Binding DataContext.SelectPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource Note}" Foreground="{StaticResource Amber}" Margin="0,0,0,12" Text="{Binding ServerNote}"
                       Visibility="{Binding ServerStopped, Converter={StaticResource Vis}}"/>

            <!-- busy strip: progress and Stop -->
            <Border Style="{StaticResource CardBox}" Width="980" Visibility="{Binding IsBusy, Converter={StaticResource Vis}}" BorderBrush="{StaticResource Amber}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="Stop" Command="{Binding CancelCommand}" Margin="14,0,0,0" AutomationProperties.Name="Stop the import"/>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Mono}" FontSize="12" Text="{Binding ProgressText}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                        <ProgressBar Style="{StaticResource Bar}" Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource CardBox}" BorderBrush="{StaticResource Red}" BorderThickness="3,1,1,1" Visibility="{Binding HasError, Converter={StaticResource Vis}}">
                <TextBlock Style="{StaticResource Body}" FontSize="13" Foreground="{StaticResource Red}" Text="{Binding Error}" TextWrapping="Wrap"/>
            </Border>

            <!-- ================================================================ .sql files -->
            <StackPanel Visibility="{Binding IsSqlPage, Converter={StaticResource Vis}}">
                <WrapPanel Margin="0,0,0,16">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ChooseSqlCommand}" Margin="0,0,10,6" AutomationProperties.Name="Choose a .sql file">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconFolder}" Width="12" Height="12" Margin="0,0,8,0"/>
                            <TextBlock Text="Choose a .sql file…"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Style="{StaticResource Note}" VerticalAlignment="Center" Margin="4,0,0,6" Text="or drop one here · .sql, .sql.gz and .zip, any size"/>
                </WrapPanel>

                <Border Style="{StaticResource CardBox}" Visibility="{Binding HasSqlPreview, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Style="{StaticResource TinyButton}" Content="clear" Command="{Binding ClearSqlCommand}" AutomationProperties.Name="Clear the file"/>
                            <TextBlock FontFamily="{StaticResource FontDisplay}" FontWeight="SemiBold" FontSize="19" Foreground="{StaticResource Ink}" Text="{Binding SqlFileName}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Ink3}" Text="{Binding SqlFileInfo}" Margin="0,0,0,10"/>
                        <TextBlock Style="{StaticResource Body}" FontSize="13.5" Text="{Binding SqlWhatText}" TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource Body}" FontSize="13" Foreground="{StaticResource Amber}" Text="{Binding SqlDropsText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding HasSqlDrops, Converter={StaticResource Vis}}"/>

                        <StackPanel Margin="0,14,0,0" Visibility="{Binding SqlNeedsDatabase, Converter={StaticResource Vis}}">
                            <TextBlock Style="{StaticResource Label}" Text="INTO THE DATABASE"/>
                            <ComboBox Style="{StaticResource Field}" IsEditable="True" ItemsSource="{Binding DatabaseNames}"
                                      Text="{Binding SqlTarget, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Database to import into"/>
                        </StackPanel>

                        <StackPanel Margin="0,16,0,0" Visibility="{Binding HasSqlRewrites, Converter={StaticResource Vis}}">
                            <TextBlock Style="{StaticResource Label}" Text="{Binding SqlRewritesHeading}"/>
                            <Border BorderBrush="{StaticResource Ink}" BorderThickness="0,2,0,0">
                                <ItemsControl ItemsSource="{Binding SqlRewrites}" ItemTemplate="{StaticResource RewriteItem}" Focusable="False"/>
                            </Border>
                        </StackPanel>

                        <Expander Margin="0,12,0,0" Header="First lines of the file" Foreground="{StaticResource Ink2}">
                            <TextBox Text="{Binding SqlFirstLines, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource FontMono}" FontSize="11.5"
                                     MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" Margin="0,6,0,0"
                                     AutomationProperties.Name="First lines of the file"/>
                        </Expander>

                        <WrapPanel Margin="0,16,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding ImportSqlCommand}" Margin="0,0,12,0" AutomationProperties.Name="Import this file">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconPlay}" Width="10" Height="11" Margin="0,0,8,0"/>
                                    <TextBlock Text="Import"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Style="{StaticResource Note}" VerticalAlignment="Center" Text="Databases it changes are backed up first. Errors don't stop the import; each is explained below."/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBox}" Visibility="{Binding HasSqlResult, Converter={StaticResource Vis}}" BorderThickness="3,1,1,1"
                        BorderBrush="{Binding SqlResultTone, Converter={StaticResource Fg}}">
                    <StackPanel>
                        <TextBlock FontFamily="{StaticResource FontDisplay}" FontWeight="SemiBold" FontSize="17" Foreground="{StaticResource Ink}" Text="{Binding SqlResultHeading}" TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource Body}" FontSize="12.5" Foreground="{StaticResource Ink2}" Text="{Binding SqlResultNote}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding SqlSkipped.Count, Converter={StaticResource Vis}}">
                            <TextBlock Style="{StaticResource Label}" Text="SKIPPED, AND WHY"/>
                            <ItemsControl ItemsSource="{Binding SqlSkipped}" ItemTemplate="{StaticResource RewriteItem}" Focusable="False"/>
                        </StackPanel>
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding SqlProblems.Count, Converter={StaticResource Vis}}">
                            <TextBlock Style="{StaticResource Label}" Text="COMMANDS THAT FAILED"/>
                            <Border BorderBrush="{StaticResource Ink}" BorderThickness="0,2,0,0">
                                <ItemsControl ItemsSource="{Binding SqlProblems}" ItemTemplate="{StaticResource ProblemItem}" Focusable="False"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ================================================================ CSV / Excel into a table -->
            <StackPanel Visibility="{Binding IsTablePage, Converter={StaticResource Vis}}">
                <WrapPanel Margin="0,0,0,16">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ChooseTableFileCommand}" Margin="0,0,10,6" AutomationProperties.Name="Choose a CSV or Excel file">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconFolder}" Width="12" Height="12" Margin="0,0,8,0"/>
                            <TextBlock Text="Choose a CSV or Excel file…"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Style="{StaticResource Note}" VerticalAlignment="Center" Margin="4,0,0,6" Text="or drop one here · .csv, .tsv and .xlsx"/>
                </WrapPanel>

                <Border Style="{StaticResource CardBox}" Visibility="{Binding HasTablePreview, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Style="{StaticResource TinyButton}" Content="clear" Command="{Binding ClearTableCommand}" AutomationProperties.Name="Clear the file"/>
                            <TextBlock FontFamily="{StaticResource FontDisplay}" FontWeight="SemiBold" FontSize="19" Foreground="{StaticResource Ink}" Text="{Binding TableFileName}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Ink3}" Text="{Binding TableFileInfo}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <!-- how to read it -->
                        <WrapPanel Margin="0,0,0,8">
                            <StackPanel Margin="0,0,22,8" Visibility="{Binding HasSheets, Converter={StaticResource Vis}}">
                                <TextBlock Style="{StaticResource Label}" Text="SHEET"/>
                                <ComboBox Style="{StaticResource Field}" Width="180" ItemsSource="{Binding Sheets}" SelectedItem="{Binding Sheet}" AutomationProperties.Name="Sheet"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,22,8" Visibility="{Binding IsCsv, Converter={StaticResource Vis}}">
                                <TextBlock Style="{StaticResource Label}" Text="COLUMNS SPLIT BY"/>
                                <ComboBox Style="{StaticResource Field}" Width="160" ItemsSource="{Binding Delimiters}" SelectedItem="{Binding Delimiter}" AutomationProperties.Name="Columns split by"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,22,8" VerticalAlignment="Bottom">
                                <CheckBox Style="{StaticResource LedgerCheck}" IsChecked="{Binding HasHeader}" Content="First row is the column names" Margin="0,0,0,4"/>
                                <CheckBox Style="{StaticResource LedgerCheck}" IsChecked="{Binding MonthFirst}" Content="Dates are month first (US: 12/25/2024)"/>
                            </StackPanel>
                        </WrapPanel>

                        <TextBlock Style="{StaticResource Label}" Text="FIRST ROWS"/>
                        <Border BorderBrush="{StaticResource Rule}" BorderThickness="1" MaxHeight="230" Margin="0,0,0,16">
                            <DataGrid Style="{StaticResource LedgerGrid}" AutoGenerateColumns="True" ItemsSource="{Binding PreviewRows}" FontFamily="{StaticResource FontMono}" FontSize="12"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanUserSortColumns="False" AutomationProperties.Name="First rows of the file"/>
                        </Border>

                        <!-- where it goes -->
                        <WrapPanel Margin="0,0,0,6">
                            <StackPanel Margin="0,0,22,8">
                                <TextBlock Style="{StaticResource Label}" Text="DATABASE"/>
                                <ComboBox Style="{StaticResource Field}" IsEditable="True" ItemsSource="{Binding DatabaseNames}"
                                          Text="{Binding TableDatabase, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Database"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,22,8">
                                <TextBlock Style="{StaticResource Label}" Text="TABLE"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <CheckBox Style="{StaticResource LedgerCheck}" IsChecked="{Binding ToNewTable}" Content="New table" Margin="0,0,16,0"/>
                                    <CheckBox Style="{StaticResource LedgerCheck}" IsChecked="{Binding ToExistingTable}" Content="Add to an existing one"/>
                                </StackPanel>
                                <TextBox Width="220" HorizontalAlignment="Left" Text="{Binding TableName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="New table name"
                                         Visibility="{Binding ToNewTable, Converter={StaticResource Vis}}"/>
                                <ComboBox Style="{StaticResource Field}" ItemsSource="{Binding ExistingTables}" SelectedItem="{Binding TableName}" AutomationProperties.Name="Existing table"
                                          Visibility="{Binding ToExistingTable, Converter={StaticResource Vis}}"/>
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Note}" Text="{Binding NewTableNote}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <!-- columns -->
                        <TextBlock Style="{StaticResource Label}" Text="COLUMNS · UNTICK ONES YOU DON'T WANT"/>
                        <Border BorderBrush="{StaticResource Ink}" BorderThickness="0,2,0,0" Margin="0,0,0,14">
                            <ItemsControl ItemsSource="{Binding Columns}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ColumnLine}">
                                        <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1" Padding="0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="190"/>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Style="{StaticResource LedgerCheck}" IsChecked="{Binding Include}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Header}"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource Mono}" FontSize="12" Text="{Binding Header}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" ToolTip="{Binding Header}"/>
                                                <TextBox Grid.Column="2" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" FontFamily="{StaticResource FontMono}" FontSize="12"
                                                         IsEnabled="{Binding Include}" AutomationProperties.Name="Column name"/>
                                                <ComboBox Grid.Column="3" IsEditable="True" ItemsSource="{Binding DataContext.TypeChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          Text="{Binding Type, UpdateSourceTrigger=LostFocus}" Margin="0,0,10,0" IsEnabled="{Binding Include}" AutomationProperties.Name="Column type"/>
                                                <TextBlock Grid.Column="4" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Ink3}" Text="{Binding Examples}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Examples}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <WrapPanel>
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding ImportTableCommand}" Margin="0,0,12,0" AutomationProperties.Name="Import the rows">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconPlay}" Width="10" Height="11" Margin="0,0,8,0"/>
                                    <TextBlock Text="Import the rows"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Style="{StaticResource Note}" VerticalAlignment="Center" Text="500 rows at a time; a row that can't go in is listed, the rest still go in."/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBox}" Visibility="{Binding HasTableResult, Converter={StaticResource Vis}}" BorderThickness="3,1,1,1"
                        BorderBrush="{Binding TableResultTone, Converter={StaticResource Fg}}">
                    <StackPanel>
                        <TextBlock FontFamily="{StaticResource FontDisplay}" FontWeight="SemiBold" FontSize="17" Foreground="{StaticResource Ink}" Text="{Binding TableResultHeading}" TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource Body}" FontSize="12.5" Foreground="{StaticResource Ink2}" Text="{Binding TableResultNote}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding TableProblems.Count, Converter={StaticResource Vis}}">
                            <TextBlock Style="{StaticResource Label}" Text="ROWS THAT COULDN'T GO IN"/>
                            <Border BorderBrush="{StaticResource Ink}" BorderThickness="0,2,0,0">
                                <ItemsControl ItemsSource="{Binding TableProblems}" ItemTemplate="{StaticResource ProblemItem}" Focusable="False"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ================================================================ export -->
            <StackPanel Visibility="{Binding IsExportPage, Converter={StaticResource Vis}}">
                <Border Style="{StaticResource CardBox}">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,8">
                            <StackPanel Margin="0,0,22,8">
                                <TextBlock Style="{StaticResource Label}" Text="DATABASE"/>
                                <ComboBox Style="{StaticResource Field}" ItemsSource="{Binding ExportDatabases}" SelectedItem="{Binding ExportDatabase}" AutomationProperties.Name="Database to export"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,22,8" Visibility="{Binding CanPickTable, Converter={StaticResource Vis}}">
                                <TextBlock Style="{StaticResource Label}" Text="TABLE"/>
                                <ComboBox Style="{StaticResource Field}" ItemsSource="{Binding ExportTables}" SelectedItem="{Binding ExportTable}" AutomationProperties.Name="Table to export"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,22,8">
                                <TextBlock Style="{StaticResource Label}" Text="AS"/>
                                <ComboBox Style="{StaticResource Field}" Width="170" ItemsSource="{Binding Formats}" SelectedItem="{Binding FormatName}" AutomationProperties.Name="Export format"/>
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Note}" Text="{Binding FormatNote}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <CheckBox Style="{StaticResource LedgerCheck}" IsChecked="{Binding Compatible}" Margin="0,0,0,14" Visibility="{Binding FormatSql, Converter={StaticResource Vis}}"
                                  Content="Make it open in XAMPP, MySQL 8 and phpMyAdmin too (changes MariaDB 11-only collations)"/>
                        <WrapPanel>
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExportCommand}" Margin="0,0,10,6" AutomationProperties.Name="Export">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconDown}" Width="11" Height="11" Margin="0,0,8,0"/>
                                    <TextBlock Text="Export"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuietButton}" Command="{Binding OpenExportsCommand}" Margin="0,0,10,6" Padding="10,6" AutomationProperties.Name="Open the exports folder">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconFolder}" Width="12" Height="12" Margin="0,0,7,0"/>
                                    <TextBlock Text="Open the exports folder"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Mono}" FontSize="10.5" Foreground="{StaticResource Ink3}" Text="{Binding ExportsFolder}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBox}" BorderThickness="3,1,1,1" BorderBrush="{StaticResource Green}" Visibility="{Binding HasExported, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="WRITTEN"/>
                        <ItemsControl ItemsSource="{Binding ExportedFiles}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ExportFileLine}">
                                    <DockPanel Margin="0,0,0,4">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource TinyButton}" Content="show" ToolTip="{Binding Path}" AutomationProperties.Name="Show the file"
                                                Command="{Binding DataContext.ShowFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Ink3}" Text="{Binding Size}" Margin="10,0"/>
                                        <TextBlock Style="{StaticResource Mono}" FontSize="12" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Body}" FontSize="12.5" Foreground="{StaticResource Ink2}" Text="{Binding ExportNote}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
