<UserControl x:Class="LuminaDB.App.Views.BackupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:LuminaDB.App.Controls"
             xmlns:vm="clr-namespace:LuminaDB.App.ViewModels">
    <UserControl.Resources>
        <c:BoolToVisibility x:Key="Vis"/>
        <c:BoolToVisibility x:Key="NotVis" Invert="True"/>
        <c:PaletteBrush x:Key="Fg"/>
        <Style x:Key="Th" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
            <Setter Property="Margin" Value="10,0,10,6"/>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="32,26,32,40">
            <TextBlock Style="{StaticResource Eyebrow}" Text="BACKUPS · EVERY CHANGE CAN BE TAKEN BACK"/>
            <TextBlock Style="{StaticResource H2}" Text="{Binding Heading}"/>
            <TextBlock Style="{StaticResource Note}" Margin="0,-6,0,16" Text="{Binding ScheduleNote}" TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left"/>

            <WrapPanel Margin="0,0,0,22">
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding BackUpAllCommand}" Margin="0,0,10,6" AutomationProperties.Name="Back up everything now">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconPlus}" Width="11" Height="11" Margin="0,0,8,0"/>
                        <TextBlock Text="Back up everything now"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QuietButton}" Command="{Binding OpenFolderCommand}" Margin="0,0,10,6" Padding="10,6" AutomationProperties.Name="Open the backups folder">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconFolder}" Width="12" Height="12" Margin="0,0,7,0"/>
                        <TextBlock Text="Open the backups folder"/>
                    </StackPanel>
                </Button>
                <TextBlock Style="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource Amber}" VerticalAlignment="Center" Margin="4,0,0,6"
                           Text="{Binding BusyText}" Visibility="{Binding IsBusy, Converter={StaticResource Vis}}"/>
            </WrapPanel>

            <TextBlock Style="{StaticResource Note}" FontSize="13.5" Text="No databases yet. Make one on Today (F1) and it is backed up from then on."
                       Visibility="{Binding HasDatabases, Converter={StaticResource NotVis}}"/>

            <Grid Visibility="{Binding HasDatabases, Converter={StaticResource Vis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ======================================================== the index of databases -->
                <StackPanel Margin="0,0,22,0">
                    <TextBlock Style="{StaticResource Eyebrow}" Text="DATABASES" Margin="0,0,0,6"/>
                    <Border BorderBrush="{DynamicResource Ink}" BorderThickness="0,2,0,0">
                        <ItemsControl ItemsSource="{Binding Databases}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BackupDatabase}">
                                    <Button Command="{Binding DataContext.SelectDatabaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource IndexButton}">
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Style>
                                        </Button.Style>
                                        <Border Padding="6,5" Margin="-8,-4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AmberSoft}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Margin="8,0">
                                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource FontDisplay}" FontWeight="SemiBold" FontSize="15"
                                                           Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Style="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Ink3}">
                                                    <Run Text="{Binding CountText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding LatestText, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Red}" Text="{Binding GoneText}"
                                                           Visibility="{Binding IsGone, Converter={StaticResource Vis}}"/>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- ======================================================== backups of the selected database -->
                <StackPanel Grid.Column="1" Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Margin="0" Command="{Binding BackUpSelectedCommand}"
                                AutomationProperties.Name="Back up this database now">
                            <TextBlock><Run Text="Back up "/><Run Text="{Binding SelectedName, Mode=OneWay}"/><Run Text=" now"/></TextBlock>
                        </Button>
                        <TextBlock FontFamily="{StaticResource FontDisplay}" FontWeight="SemiBold" FontSize="20" Foreground="{DynamicResource Ink}"
                                   Text="{Binding SelectedName}" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Body}" FontSize="12.5" Margin="0,0,0,10" Text="{Binding SelectedNote}" TextWrapping="Wrap"/>

                    <Border Background="{DynamicResource Paper3}" BorderBrush="{DynamicResource Rule}" BorderThickness="1"
                            Visibility="{Binding HasRows, Converter={StaticResource Vis}}">
                        <StackPanel Grid.IsSharedSizeScope="True">
                            <Border BorderBrush="{DynamicResource Ink}" BorderThickness="0,0,0,2" Padding="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="118"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="Auto" MinWidth="170" SharedSizeGroup="BackupActions"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Th}" Text="TAKEN"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Th}" Text="KIND"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Th}" Text="WHY"/>
                                    <TextBlock Grid.Column="3" Style="{StaticResource Th}" Text="SIZE" TextAlignment="Right"/>
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:BackupRow}">
                                        <Border BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,0,1" Padding="0,6" ToolTip="{Binding Info.SqlFile}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="118"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="Auto" MinWidth="170" SharedSizeGroup="BackupActions"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource Cell}" Text="{Binding When}" Foreground="{DynamicResource Ink}"/>
                                                    <TextBlock Style="{StaticResource Cell}" FontSize="11" Text="{Binding Ago}" Foreground="{DynamicResource Ink3}"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Margin="10,0" HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="1" CornerRadius="2" Padding="5,1"
                                                        BorderBrush="{Binding Tone, Converter={StaticResource Fg}}">
                                                    <TextBlock Text="{Binding KindText}" FontFamily="{StaticResource FontMonoMedium}" FontSize="11"
                                                               Foreground="{Binding Tone, Converter={StaticResource Fg}}"/>
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource Cell}" FontFamily="{StaticResource FontBody}" FontSize="12.5" Text="{Binding Reason}"
                                                               Foreground="{DynamicResource Ink2}" ToolTip="{Binding Reason}"/>
                                                    <TextBlock Style="{StaticResource Cell}" FontSize="11" Text="{Binding KeepText}" Foreground="{DynamicResource Green}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" Style="{StaticResource Cell}" TextAlignment="Right" Text="{Binding Size}"/>
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0,8,0">
                                                    <Button Style="{StaticResource ToolButton}" Margin="0,0,4,0" Content="Restore" AutomationProperties.Name="Restore this backup"
                                                            Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource TinyButton}" Content="file" ToolTip="Show the .sql file" AutomationProperties.Name="Show the file"
                                                            Command="{Binding DataContext.ShowFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource TinyButton}" Content="delete" ToolTip="Delete this backup" AutomationProperties.Name="Delete this backup"
                                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Note}" Margin="0,10,0,0" Text="{Binding KeepNote}" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Ink3}" Margin="0,4,0,0" Text="{Binding FolderText}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <!-- ======================================================== project snapshots (taken in Projects) -->
            <TextBlock Style="{StaticResource Eyebrow}" Text="PROJECT SNAPSHOTS · CODE + DATABASE TOGETHER" Margin="0,34,0,6"/>
            <TextBlock Style="{StaticResource Note}" Text="None yet. In Projects (F2) → Snapshots, one press saves a project's code and its database together."
                       Visibility="{Binding HasSnapshots, Converter={StaticResource NotVis}}" TextWrapping="Wrap"/>
            <Border Background="{DynamicResource Paper3}" BorderBrush="{DynamicResource Rule}" BorderThickness="1" MaxWidth="900" HorizontalAlignment="Left"
                    Visibility="{Binding HasSnapshots, Converter={StaticResource Vis}}">
                <ItemsControl ItemsSource="{Binding Snapshots}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SnapshotListRow}">
                            <Border BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,0,1" Padding="0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Cell}" FontFamily="{StaticResource FontDisplay}" FontWeight="SemiBold" FontSize="14" Text="{Binding Project}" Foreground="{DynamicResource Ink}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Cell}" Text="{Binding When}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Cell}" FontFamily="{StaticResource FontBody}" FontSize="12.5" Foreground="{DynamicResource Ink2}" Text="{Binding Note}"/>
                                    <TextBlock Grid.Column="3" Style="{StaticResource Cell}" Foreground="{DynamicResource Ink3}" Text="{Binding Holds}"/>
                                    <TextBlock Grid.Column="4" Style="{StaticResource Cell}" TextAlignment="Right" Text="{Binding Size}"/>
                                    <Button Grid.Column="5" Style="{StaticResource TinyButton}" Margin="0,0,8,0" Content="open in Projects" AutomationProperties.Name="Open in Projects"
                                            Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
