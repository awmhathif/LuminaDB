<UserControl x:Class="LuminaDB.App.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:LuminaDB.App.Controls"
             xmlns:vm="clr-namespace:LuminaDB.App.ViewModels"
             xmlns:web="clr-namespace:LuminaDB.Core.Web;assembly=LuminaDB.Core"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <UserControl.Resources>
        <c:BoolToVisibility x:Key="Vis"/>
        <c:BoolToVisibility x:Key="NotVis" Invert="True"/>
        <c:PaletteBrush x:Key="Fg"/>

        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Ink3}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>
        <Style x:Key="ConsoleBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Background" Value="{StaticResource Paper3}"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Rule}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style x:Key="Field" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="140"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="LogKindButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Style.Triggers>
                <Trigger Property="Tag"><Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value>
                    <Setter Property="Background" Value="{StaticResource Ink}"/>
                    <Setter Property="Foreground" Value="{StaticResource Paper3}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="22,18,22,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ======================================================== index: web status + project list -->
        <DockPanel Grid.Column="0" Margin="0,0,20,0">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Style="{StaticResource Eyebrow}" Text="PROJECTS"/>
                <TextBlock FontFamily="{StaticResource FontDisplay}" FontWeight="Bold" FontSize="20" Text="{Binding ListHeading}" TextOptions.TextFormattingMode="Ideal"/>
                <Border Height="2" Background="{StaticResource Ink}" Margin="0,6,0,10"/>

                <TextBlock FontSize="13.5" TextWrapping="Wrap" Foreground="{StaticResource Ink}">
                    <Run Text="Web is "/><Run Text="{Binding WebStatusWord, Mode=OneWay}" FontWeight="SemiBold" Foreground="{Binding WebTone, Converter={StaticResource Fg}}"/><Run Text="{Binding WebStatusTail, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Style="{StaticResource Note}" FontSize="12" Foreground="{StaticResource Red}" Text="{Binding WebProblem}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding HasWebProblem, Converter={StaticResource Vis}}"/>
                <Button Style="{StaticResource ToolButton}" Command="{Binding ToggleWebCommand}" Content="{Binding WebButtonText}" HorizontalAlignment="Left" Margin="0,8,0,14"
                        AutomationProperties.Name="Start or stop the web server"/>

                <WrapPanel Margin="0,0,0,10">
                    <Button Style="{StaticResource ToolPrimary}" Command="{Binding NewProjectCommand}" Margin="0,0,8,6" AutomationProperties.Name="New project">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconPlus}" Width="10" Height="10" Margin="0,0,7,0"/>
                            <TextBlock Text="New project"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding ImportFolderCommand}" Margin="0,0,0,6" AutomationProperties.Name="Import a folder"
                            ToolTip="Copy a project from XAMPP's htdocs or anywhere else">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconFolder}" Width="11" Height="11" Margin="0,0,7,0"/>
                            <TextBlock Text="Import folder"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>

            <!-- folders whose names can't be web addresses -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource AmberSoft}" Padding="10,8" Margin="0,10,0,0"
                    Visibility="{Binding HasUnusable, Converter={StaticResource Vis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" FontSize="12" TextWrapping="Wrap" Text="These folders aren't served: their names can't be web addresses."/>
                    <ItemsControl ItemsSource="{Binding Unusable}" Focusable="False" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource TinyButton}" Content="rename"
                                            Command="{Binding DataContext.RenameFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Key}"
                                            ToolTip="{Binding Value}" AutomationProperties.Name="Rename folder"/>
                                    <TextBlock Style="{StaticResource Mono}" FontSize="11.5" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Key, Mode=OneWay}"/><Run Text=" → " Foreground="{StaticResource Ink3}"/><Run Text="{Binding Value, Mode=OneWay}"/>
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <ItemsControl ItemsSource="{Binding Projects}" Focusable="False" AutomationProperties.Name="Projects">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProjectItem}">
                            <Button Style="{StaticResource IndexButton}" Command="{Binding DataContext.SelectProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}">
                                <StackPanel Margin="0,3">
                                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource FontDisplay}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Ink3}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- ======================================================== no project yet -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="{Binding NoSelection, Converter={StaticResource Vis}}">
            <StackPanel MaxWidth="640" HorizontalAlignment="Left" Margin="6,0,0,0">
                <TextBlock Style="{StaticResource Eyebrow}" Text="START HERE"/>
                <TextBlock Style="{StaticResource H2}" Text="Make your first PHP project."/>
                <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,16"
                           Text="A project is a folder, its own database and a web address like http://my-shop.localhost. Start from a template that already connects to MariaDB, or copy in a folder from XAMPP's htdocs."/>
                <Border Background="{StaticResource Paper3}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="16,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}" FontSize="13"><Run Text="CRUD  " FontWeight="SemiBold"/><Run Text="a students table you can add to, edit and delete from, safely (PDO, prepared statements)."/></TextBlock>
                        <TextBlock Style="{StaticResource Body}" FontSize="13" Margin="0,6,0,0"><Run Text="Login  " FontWeight="SemiBold"/><Run Text="register and sign in with password_hash, sessions and CSRF checks."/></TextBlock>
                        <TextBlock Style="{StaticResource Body}" FontSize="13" Margin="0,6,0,0"><Run Text="REST API  " FontWeight="SemiBold"/><Run Text="JSON endpoints for items, with proper status codes."/></TextBlock>
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding NewProjectCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" Content="New project"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ======================================================== one project -->
        <DockPanel Grid.Column="1" Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Style="{StaticResource Eyebrow}" Text="PROJECT"/>
                <TextBlock Text="{Binding Selected.Name}" FontFamily="{StaticResource FontDisplay}" FontWeight="ExtraBold" FontSize="30" TextOptions.TextFormattingMode="Ideal"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                    <TextBlock Style="{StaticResource Mono}" FontSize="13" Text="{Binding HostUrl}" Foreground="{StaticResource Blue}" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource TinyButton}" Command="{Binding CopyCommand}" CommandParameter="{Binding HostUrl}" ToolTip="Copy the address"
                            AutomationProperties.Name="Copy address" Margin="4,0,0,0">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconCopy}" Width="11" Height="11"/>
                    </Button>
                </StackPanel>
                <WrapPanel>
                    <Button Style="{StaticResource ToolPrimary}" Command="{Binding OpenBrowserCommand}" Margin="0,0,8,6" AutomationProperties.Name="Open in browser">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconArrow}" Width="11" Height="11" Margin="0,0,7,0" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><ScaleTransform ScaleX="-1"/></Path.RenderTransform></Path>
                            <TextBlock Text="Open in browser"/>
                        </StackPanel>
                    </Button>
                    <ItemsControl ItemsSource="{Binding Editors}" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:EditorChoice}">
                                <Button Style="{StaticResource ToolButton}" Margin="0,0,8,6" Content="{Binding Name}" ToolTip="Open the project folder in this program"
                                        Command="{Binding DataContext.OpenEditorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding OpenDatabaseCommand}" Margin="0,0,8,6" Content="Database in Notebook"
                            ToolTip="Write SQL against this project's database"/>
                </WrapPanel>
                <ItemsControl ItemsSource="{Binding Pages}" Focusable="False" Margin="0,10,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PageChip}">
                            <Button Style="{StaticResource PageChipButton}" Content="{Binding Label}" AutomationProperties.Name="{Binding Label}"
                                    Command="{Binding DataContext.SelectPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Height="1" Background="{StaticResource Rule}" Margin="0,0,0,14"/>
            </StackPanel>

            <Grid>
                <!-- ················································ overview -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="{Binding IsOverview, Converter={StaticResource Vis}}">
                    <WrapPanel>
                        <Border Style="{StaticResource Card}" Width="400">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Eyebrow}" Text="ADDRESSES"/>
                                <DockPanel Margin="0,4,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource TinyButton}" Content="open" Command="{Binding OpenBrowserCommand}" CommandParameter="{Binding HostUrl}"/>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource TinyButton}" Content="copy" Command="{Binding CopyCommand}" CommandParameter="{Binding HostUrl}"/>
                                    <TextBlock Style="{StaticResource Value}" Text="{Binding HostUrl}"/>
                                </DockPanel>
                                <DockPanel Margin="0,4,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource TinyButton}" Content="open" Command="{Binding OpenBrowserCommand}" CommandParameter="{Binding PathUrl}"/>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource TinyButton}" Content="copy" Command="{Binding CopyCommand}" CommandParameter="{Binding PathUrl}"/>
                                    <TextBlock Style="{StaticResource Value}" Text="{Binding PathUrl}"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Note}" FontSize="12" Text="{Binding UrlNote}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock Style="{StaticResource Body}" FontSize="12.5" Text="{Binding ServedBy}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Width="400">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Eyebrow}" Text="DATABASE"/>
                                <DockPanel Margin="0,4,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource TinyButton}" Content="copy" Command="{Binding CopyCommand}" CommandParameter="{Binding DatabaseText}"/>
                                    <TextBlock Style="{StaticResource Value}" FontSize="15" FontWeight="SemiBold" Text="{Binding DatabaseText}"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Ink2}" Text="{Binding ConfigText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Style="{StaticResource Note}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="The template's config.php already has these settings. If the server moves to another port, PHP follows it."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Width="400">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Eyebrow}" Text="FOLDER"/>
                                <DockPanel Margin="0,4,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource TinyButton}" Content="open" Command="{Binding OpenFolderCommand}"/>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource TinyButton}" Content="copy" Command="{Binding CopyCommand}" CommandParameter="{Binding FolderText}"/>
                                    <TextBlock Style="{StaticResource Value}" FontSize="12" Text="{Binding FolderText}"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Note}" FontSize="12" Text="{Binding CreatedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <Button Style="{StaticResource ToolDanger}" Command="{Binding DeleteCommand}" Content="Delete project…" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Width="400">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Eyebrow}" Text="SHARE PACK"/>
                                <TextBlock Style="{StaticResource Body}" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,10"
                                           Text="One zip to hand to anyone (a teammate, a client, a marker): the code, the database as .sql and a README that says how to run it. Imports into XAMPP too."/>
                                <TextBlock Style="{StaticResource Label}" Text="YOUR NAME OR ID (OPTIONAL)"/>
                                <TextBox Text="{Binding StudentId, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" Width="200" HorizontalAlignment="Left" AutomationProperties.Name="Your name or ID" ToolTip="Goes at the start of the zip&apos;s name, so it&apos;s clear whose it is"/>
                                <CheckBox Style="{StaticResource LedgerCheck}" IsChecked="{Binding IncludeVendor}" Margin="0,10,0,0" ><TextBlock Text="Include vendor and node_modules (rarely wanted)"/></CheckBox>
                                <TextBlock Style="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Ink2}" Text="{Binding PackName}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Style="{StaticResource ToolPrimary}" Command="{Binding BuildPackCommand}" Content="Build the pack"/>
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding ShowPackCommand}" Content="Show in folder" Visibility="{Binding HasLastPack, Converter={StaticResource Vis}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </ScrollViewer>

                <!-- ················································ logs -->
                <DockPanel Visibility="{Binding IsLogs, Converter={StaticResource Vis}}">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource ToolButton}" Command="{Binding OpenLogFileCommand}" Content="Open file"/>
                            <Button Style="{StaticResource ToolButton}" Command="{Binding ClearLogCommand}" Content="Clear" Margin="0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource LogKindButton}" Tag="{Binding IsPhpLog}" Command="{Binding ShowPhpLogCommand}" Content="PHP errors"/>
                            <Button Style="{StaticResource LogKindButton}" Tag="{Binding IsAccessLog}" Command="{Binding ShowAccessLogCommand}" Content="Requests"/>
                        </StackPanel>
                    </DockPanel>
                    <Grid>
                        <TextBox x:Name="LogBox" Style="{StaticResource ConsoleBox}" Text="{Binding LogText, Mode=OneWay}" AutomationProperties.Name="Log"/>
                        <TextBlock Style="{StaticResource Note}" Text="{Binding LogEmptyText}" Margin="14,10" IsHitTestVisible="False" TextWrapping="Wrap"
                                   Visibility="{Binding LogIsEmpty, Converter={StaticResource Vis}}"/>
                    </Grid>
                </DockPanel>

                <!-- ················································ PHP settings -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="{Binding IsPhp, Converter={StaticResource Vis}}">
                    <WrapPanel>
                        <Border Style="{StaticResource Card}" Width="400">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Eyebrow}" Text="THIS PROJECT"/>
                                <TextBlock Style="{StaticResource Body}" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,12"
                                           Text="Saved to the project's .user.ini. PHP reads it within 5 seconds; nothing restarts."/>
                                <TextBlock Style="{StaticResource Label}" Text="LARGEST UPLOAD"/>
                                <ComboBox Style="{StaticResource Field}" ItemsSource="{Binding UploadSizes}" SelectedItem="{Binding Upload}" AutomationProperties.Name="Largest upload"/>
                                <TextBlock Style="{StaticResource Label}" Text="MEMORY PER PAGE" Margin="0,10,0,3"/>
                                <ComboBox Style="{StaticResource Field}" ItemsSource="{Binding MemoryLimits}" SelectedItem="{Binding Memory}" AutomationProperties.Name="Memory per page"/>
                                <TextBlock Style="{StaticResource Label}" Text="TIME LIMIT (SECONDS)" Margin="0,10,0,3"/>
                                <ComboBox Style="{StaticResource Field}" ItemsSource="{Binding TimeLimits}" Text="{Binding TimeLimit, UpdateSourceTrigger=PropertyChanged}" IsEditable="True"
                                          AutomationProperties.Name="Time limit"/>
                                <TextBlock Style="{StaticResource Label}" Text="TIME ZONE" Margin="0,10,0,3"/>
                                <TextBox Text="{Binding TimeZone, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left" FontFamily="{StaticResource FontMono}"
                                         AutomationProperties.Name="Time zone"/>
                                <TextBlock Style="{StaticResource Note}" FontSize="12" Text="{Binding PcTimeZone}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <CheckBox Style="{StaticResource LedgerCheck}" IsChecked="{Binding Deprecations}" Margin="0,12,0,0" Content="Show deprecation notices too"/>
                                <TextBlock Style="{StaticResource Note}" Foreground="{StaticResource Red}" Text="{Binding PhpProblem}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Visibility="{Binding HasPhpProblem, Converter={StaticResource Vis}}"/>
                                <Button Style="{StaticResource ToolPrimary}" Command="{Binding SavePhpCommand}" Content="Save" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Width="400">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Eyebrow}" Text="EXTENSIONS · EVERY PROJECT"/>
                                <TextBlock Style="{StaticResource Body}" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,10"
                                           Text="One PHP serves all projects, so extensions are shared. Saving restarts PHP (about a second)."/>
                                <ItemsControl ItemsSource="{Binding Extensions}" Focusable="False">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ExtensionChoice}">
                                            <CheckBox Style="{StaticResource LedgerCheck}" IsChecked="{Binding IsOn}" Width="120" Margin="0,0,0,6" AutomationProperties.Name="{Binding Name}">
                                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource FontMono}" FontSize="12"/>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource ToolButton}" Command="{Binding SaveExtensionsCommand}" Content="Save and restart PHP" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </ScrollViewer>

                <!-- ················································ composer -->
                <DockPanel Visibility="{Binding IsComposer, Converter={StaticResource Vis}}">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Border Background="{StaticResource AmberSoft}" Padding="12,8" Margin="0,0,0,10" Visibility="{Binding NoComposer, Converter={StaticResource Vis}}">
                            <TextBlock Style="{StaticResource Body}" FontSize="12.5" TextWrapping="Wrap"
                                       Text="Composer isn't in this LuminaDB folder yet (engines\…\composer\composer.phar). The Laravel template needs it too."/>
                        </Border>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource ToolPrimary}" Command="{Binding RunComposerCommand}" Content="Run" Margin="8,0,8,0" IsDefault="{Binding IsKeyboardFocusWithin, ElementName=ComposerBox}"/>
                                <Button Style="{StaticResource ToolButton}" Command="{Binding StopComposerCommand}" Content="Stop" Margin="0"/>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Mono}" FontSize="13" Text="composer" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Ink3}"/>
                            <TextBox x:Name="ComposerBox" Text="{Binding ComposerCommand, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}"
                                     AutomationProperties.Name="Composer command"/>
                        </DockPanel>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Style="{StaticResource TinyButton}" Content="install" Command="{Binding RunComposerCommand}" CommandParameter="install"/>
                            <Button Style="{StaticResource TinyButton}" Content="update" Command="{Binding RunComposerCommand}" CommandParameter="update"/>
                            <Button Style="{StaticResource TinyButton}" Content="dump-autoload" Command="{Binding RunComposerCommand}" CommandParameter="dump-autoload"/>
                            <Button Style="{StaticResource TinyButton}" Content="show" Command="{Binding RunComposerCommand}" CommandParameter="show"/>
                            <Button Style="{StaticResource TinyButton}" Content="--version" Command="{Binding RunComposerCommand}" CommandParameter="--version"/>
                        </WrapPanel>
                    </StackPanel>
                    <TextBox x:Name="ComposerOut" Style="{StaticResource ConsoleBox}" Text="{Binding ComposerOutput, Mode=OneWay}" AutomationProperties.Name="Composer output"/>
                </DockPanel>

                <!-- ················································ snapshots -->
                <DockPanel Visibility="{Binding IsSnapshots, Converter={StaticResource Vis}}">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource Body}" FontSize="12.5" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                   Text="A snapshot keeps the code and the database together, so you can go back to the version that worked. Restoring saves the current state first."/>
                        <DockPanel Margin="0,10,0,0" MaxWidth="640" HorizontalAlignment="Left">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource ToolPrimary}" Command="{Binding TakeSnapshotCommand}" Content="Take snapshot" Margin="8,0,8,0"/>
                                <Button Style="{StaticResource ToolButton}" Command="{Binding OpenSnapshotsFolderCommand}" Content="Folder" Margin="0"/>
                            </StackPanel>
                            <Grid>
                                <TextBox x:Name="NoteBox" Text="{Binding SnapshotNote, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" Width="320" AutomationProperties.Name="Snapshot note"/>
                                <TextBlock Text="note, e.g. before adding login" Style="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Ink3}" Margin="9,0,0,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           Visibility="{Binding Text.IsEmpty, ElementName=NoteBox, Converter={StaticResource Vis}}"/>
                            </Grid>
                        </DockPanel>
                    </StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource Note}" Text="No snapshots yet." Visibility="{Binding HasSnapshots, Converter={StaticResource NotVis}}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsControl ItemsSource="{Binding Snapshots}" Focusable="False" Width="760" HorizontalAlignment="Left">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SnapshotRow}">
                                        <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1" Padding="4,8">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource ToolButton}" Content="Restore…"
                                                            Command="{Binding DataContext.RestoreSnapshotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource TinyButton}" Content="delete"
                                                            Command="{Binding DataContext.DeleteSnapshotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                </StackPanel>
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Mono}" FontSize="12.5" Text="{Binding When}" Width="170" VerticalAlignment="Center"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Note}" FontSize="13.5" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Contents}" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Ink3}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>

                <!-- ················································ demo mode -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="{Binding IsShare, Converter={StaticResource Vis}}">
                    <StackPanel MaxWidth="700" HorizontalAlignment="Left">
                        <!-- on -->
                        <Border Background="{StaticResource Paper3}" BorderBrush="{StaticResource Red}" BorderThickness="3,0,0,0" Padding="18,14"
                                Visibility="{Binding DemoOn, Converter={StaticResource Vis}}">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="White" Padding="0" Margin="18,0,0,0">
                                    <Image Source="{Binding DemoQr}" Width="180" Height="180" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="QR code of the demo address"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Eyebrow}" Text="DEMO MODE IS ON" Foreground="{StaticResource Red}"/>
                                    <TextBlock FontFamily="{StaticResource FontDisplay}" FontWeight="ExtraBold" FontSize="26" Text="{Binding DemoUrl}" TextWrapping="Wrap" TextOptions.TextFormattingMode="Ideal"/>
                                    <TextBlock Style="{StaticResource Body}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap">
                                        <Run Text="Showing "/><Run Text="{Binding DemoProject, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" to phones and laptops on this network. Scan the code or type the address."/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Note}" FontSize="12.5" Text="{Binding DemoUntil}" Margin="0,6,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Style="{StaticResource ToolDanger}" Command="{Binding StopDemoCommand}" Content="Stop demo"/>
                                        <Button Style="{StaticResource ToolButton}" Command="{Binding CopyCommand}" CommandParameter="{Binding DemoUrl}" Content="Copy address"/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- off -->
                        <StackPanel Visibility="{Binding DemoOff, Converter={StaticResource Vis}}">
                            <TextBlock Style="{StaticResource H3}" Text="Show it on your classmates' phones."/>
                            <TextBlock Style="{StaticResource Body}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,14"
                                       Text="For a viva or a demo: this one project opens on the same Wi-Fi for a set time, then turns itself off. Visitors never see other projects or the database, and error pages hide your code from them."/>
                            <TextBlock Style="{StaticResource Label}" Text="THIS PC'S ADDRESS ON THE NETWORK"/>
                            <DockPanel HorizontalAlignment="Left">
                                <Button DockPanel.Dock="Right" Style="{StaticResource TinyButton}" Command="{Binding RefreshAddressesCommand}" ToolTip="Look again" AutomationProperties.Name="Look for the network addresses again" Margin="6,0,0,0">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconRefresh}" Width="11" Height="11"/>
                                </Button>
                                <ComboBox ItemsSource="{Binding Addresses}" SelectedItem="{Binding SelectedAddress}" Width="300" AutomationProperties.Name="Network address"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Note}" Foreground="{StaticResource Red}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="This PC isn't on a network right now. Connect to the Wi-Fi first." Visibility="{Binding NoAddresses, Converter={StaticResource Vis}}"/>
                            <TextBlock Style="{StaticResource Label}" Text="FOR HOW LONG (MINUTES)" Margin="0,12,0,3"/>
                            <ComboBox ItemsSource="{Binding DemoMinuteChoices}" SelectedItem="{Binding DemoMinutes}" Width="100" HorizontalAlignment="Left" AutomationProperties.Name="Minutes"/>
                            <Button Style="{StaticResource ToolPrimary}" Command="{Binding StartDemoCommand}" Content="Start demo…" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                            <TextBlock Style="{StaticResource Note}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Text="Windows may ask once whether the web server may use networks. Choose Private networks only."/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>

        <!-- ======================================================== busy line -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource Paper2}" Padding="10,5" Margin="0,10,0,0"
                Visibility="{Binding IsBusy, Converter={StaticResource Vis}}">
            <TextBlock Style="{StaticResource Mono}" FontSize="12" Text="{Binding BusyText, TargetNullValue=Working…}"/>
        </Border>
    </Grid>
</UserControl>
