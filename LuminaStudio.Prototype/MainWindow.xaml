<Window x:Class="LuminaStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="LuminaDB Studio — Prototype" Width="1280" Height="800" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="212"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ================= LEFT RAIL ================= -->
    <Border Grid.Column="0" Background="{StaticResource Rail}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,20,18,24">
          <Border Width="30" Height="30" CornerRadius="7" Background="{StaticResource Accent}">
            <TextBlock Text="L" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="LuminaDB Studio" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
            <TextBlock Text="Local MySQL, no hassle" Foreground="{StaticResource RailText}" FontSize="11"/>
          </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="18,0,18,18">
          <Border Background="#1D2939" CornerRadius="6" Padding="10,8">
            <StackPanel>
              <TextBlock Text="Portable mode" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
              <TextBlock Text="Everything lives in this folder. Copy it to a USB stick and it just works." Foreground="{StaticResource RailText}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
            </StackPanel>
          </Border>
          <TextBlock Text="v0.1 prototype · mock data" Foreground="#475467" FontSize="10" Margin="2,10,0,0"/>
        </StackPanel>

        <StackPanel>
          <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}" Content="Dashboard" Tag="&#xE80F;" IsChecked="True" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavQuery" Style="{StaticResource NavItem}" Content="SQL Editor" Tag="&#xE943;" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavDoctor" Style="{StaticResource NavItem}" Content="Doctor" Tag="&#xE95E;" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavBackups" Style="{StaticResource NavItem}" Content="Backups" Tag="&#xE81C;" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Content="Settings" Tag="&#xE713;" Checked="Nav_Checked"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ================= MAIN AREA ================= -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="60"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Top bar -->
      <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
        <DockPanel Margin="24,0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Border x:Name="ServerPill" CornerRadius="12" Padding="10,4" Background="{StaticResource OkSoft}" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="ServerDot" Width="8" Height="8" Fill="{StaticResource Ok}" VerticalAlignment="Center"/>
                <TextBlock x:Name="ServerPillText" Text="MariaDB running · 127.0.0.1:3307" Margin="7,0,0,0" FontSize="12" Foreground="#027A48" FontWeight="SemiBold"/>
              </StackPanel>
            </Border>
            <Button x:Name="ServerToggleBtn" Style="{StaticResource SecondaryBtn}" Margin="10,0,0,0" Click="ServerToggle_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ServerToggleIcon" Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="11" Foreground="{StaticResource Bad}"/>
                <TextBlock x:Name="ServerToggleText" Text="Stop server" Margin="7,0,0,0"/>
              </StackPanel>
            </Button>
          </StackPanel>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock x:Name="PageSubtitle" Text="Your local database server at a glance" Style="{StaticResource MutedText}"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- ================= PAGE: DASHBOARD ================= -->
      <ScrollViewer x:Name="PageDashboard" Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Server card -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
              <StackPanel>
                <DockPanel>
                  <Border DockPanel.Dock="Right" x:Name="DashServerBadge" CornerRadius="10" Padding="8,2" Background="{StaticResource OkSoft}">
                    <TextBlock x:Name="DashServerBadgeText" Text="Running" FontSize="11" Foreground="#027A48" FontWeight="SemiBold"/>
                  </Border>
                  <TextBlock Text="Database server" Style="{StaticResource H2}"/>
                </DockPanel>
                <TextBlock Text="MariaDB 10.4 (bundled)" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,2"/>
                <TextBlock x:Name="DashServerDetail" Text="Port 3307 (3306 was busy, switched automatically) · up 2h 14m" Style="{StaticResource MutedText}"/>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                  <Button Style="{StaticResource PrimaryBtn}" Content="Open SQL Editor" Click="GoQuery_Click"/>
                  <Button Style="{StaticResource SecondaryBtn}" Content="Copy connection" Margin="8,0,0,0" Click="CopyConn_Click"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Health card -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Health (Doctor)" Style="{StaticResource H2}"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,2">
                  <TextBlock x:Name="DashHealthIcon" Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="20" Foreground="{StaticResource Warn}"/>
                  <TextBlock x:Name="DashHealthTitle" Text="2 things need attention" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="DashHealthDetail" Text="Doctor found problems that could break your server. Each one has a 1-click fix." Style="{StaticResource MutedText}"/>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                  <Button Style="{StaticResource PrimaryBtn}" Content="Open Doctor" Click="GoDoctor_Click"/>
                  <Button Style="{StaticResource SecondaryBtn}" Content="Fix all" Margin="8,0,0,0" Click="FixAll_Click"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Backup card -->
            <Border Grid.Column="4" Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Backups" Style="{StaticResource H2}"/>
                <TextBlock x:Name="DashBackupTitle" Text="Last backup 12 min ago" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,2"/>
                <TextBlock Text="Automatic every 30 min and before every risky action (DROP, DELETE, repair)." Style="{StaticResource MutedText}"/>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                  <Button Style="{StaticResource PrimaryBtn}" Content="Backup now" Click="BackupNow_Click"/>
                  <Button Style="{StaticResource SecondaryBtn}" Content="View backups" Margin="8,0,0,0" Click="GoBackups_Click"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>

          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*"/>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Databases -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
              <StackPanel>
                <DockPanel Margin="16,14,16,10">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryBtn}" Content="Import .sql" Click="Import_Click"/>
                    <Button Style="{StaticResource PrimaryBtn}" Content="+ New database" Margin="8,0,0,0" Click="NewDb_Click"/>
                  </StackPanel>
                  <TextBlock Text="Databases" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                </DockPanel>
                <DataGrid x:Name="DbGrid" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="300" SelectionUnit="FullRow" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="Tables" Binding="{Binding Tables}" Width="*"/>
                    <DataGridTextColumn Header="Rows" Binding="{Binding Rows}" Width="*"/>
                    <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="*"/>
                    <DataGridTextColumn Header="Last changed" Binding="{Binding Changed}" Width="1.5*"/>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>

            <!-- Quick info -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Connect from your code" Style="{StaticResource H2}"/>
                <TextBlock Text="Use these in PHP, Java, Python or any app." Style="{StaticResource MutedText}" Margin="0,4,0,10"/>
                <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="10">
                  <StackPanel>
                    <TextBlock FontFamily="Consolas" FontSize="12" Text="host     127.0.0.1"/>
                    <TextBlock x:Name="ConnPortText" FontFamily="Consolas" FontSize="12" Text="port     3307"/>
                    <TextBlock FontFamily="Consolas" FontSize="12" Text="user     root"/>
                    <TextBlock FontFamily="Consolas" FontSize="12" Text="password (none, local only)"/>
                  </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" Foreground="{StaticResource Ok}" FontSize="12"/>
                  <TextBlock Text="Only this PC can connect (bound to 127.0.0.1)" Style="{StaticResource MutedText}" Margin="6,0,0,0"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <!-- ================= PAGE: SQL EDITOR ================= -->
      <Grid x:Name="PageQuery" Grid.Row="1" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="240"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Schema tree -->
        <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="12,12,8,8">
              <Button DockPanel.Dock="Right" Style="{StaticResource GhostBtn}" ToolTip="Refresh" Click="Refresh_Click">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12"/>
              </Button>
              <TextBlock Text="SCHEMAS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
            </DockPanel>
            <Border DockPanel.Dock="Top" Margin="12,0,12,8" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="8,5">
              <DockPanel>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="11" Foreground="{StaticResource Muted}"/>
                <TextBox BorderThickness="0" Margin="6,0,0,0" FontSize="12" Foreground="{StaticResource Muted}" Text="Filter tables..."/>
              </DockPanel>
            </Border>
            <TreeView x:Name="SchemaTree" BorderThickness="0" Padding="6,0" MouseDoubleClick="SchemaTree_DoubleClick"/>
          </DockPanel>
        </Border>

        <Grid Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="120"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="290" MinHeight="120"/>
          </Grid.RowDefinitions>

          <!-- Toolbar -->
          <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="Database" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="DbPicker" Width="140" SelectedIndex="0" VerticalAlignment="Center">
                  <ComboBoxItem Content="college"/>
                  <ComboBoxItem Content="shop"/>
                </ComboBox>
                <CheckBox x:Name="SafeModeCheck" Content="Safe updates" IsChecked="True" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12"
                          ToolTip="Ask before UPDATE/DELETE without WHERE, and before DROP"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="RunBtn" Style="{StaticResource PrimaryBtn}" Click="Run_Click" ToolTip="Run (Ctrl+Enter)">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="11" Foreground="White"/>
                    <TextBlock Text="Run" Margin="6,0,0,0" Foreground="White"/>
                    <TextBlock Text="Ctrl+Enter" Margin="8,0,0,0" Foreground="#BFD3FE" FontSize="11" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryBtn}" Margin="8,0,0,0" Content="Format" Click="Format_Click"/>
                <Button Style="{StaticResource SecondaryBtn}" Margin="8,0,0,0" Content="Templates ▾" Click="Templates_Click"/>
                <Button Style="{StaticResource GhostBtn}" Margin="8,0,0,0" ToolTip="Undo last change (restores snapshot)" Click="Undo_Click">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" FontSize="12"/>
                    <TextBlock Text="Undo change" Margin="6,0,0,0"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </DockPanel>
          </Border>

          <!-- Editor -->
          <Border Grid.Row="1" Background="{StaticResource Surface}">
            <ae:TextEditor x:Name="Editor" FontFamily="Consolas" FontSize="14" ShowLineNumbers="True"
                           Padding="8,8,0,0" LineNumbersForeground="#98A2B3" WordWrap="False"
                           HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
          </Border>

          <!-- Live guard bar -->
          <Border x:Name="GuardBar" Grid.Row="2" Background="{StaticResource OkSoft}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="14,8">
            <DockPanel>
              <Button x:Name="GuardFixBtn" DockPanel.Dock="Right" Style="{StaticResource SecondaryBtn}" Padding="10,3" FontSize="12" Visibility="Collapsed" Click="GuardFix_Click"/>
              <TextBlock x:Name="GuardIcon" Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{StaticResource Ok}" FontSize="13"/>
              <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="GuardTitle" Text="Looks good" FontWeight="SemiBold" FontSize="12"/>
                <TextBlock x:Name="GuardDetail" Text="Reads rows from students. Read-only, safe to run." Style="{StaticResource MutedText}"/>
              </StackPanel>
            </DockPanel>
          </Border>

          <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" Background="{StaticResource Border}" ResizeDirection="Rows"/>

          <!-- Results -->
          <Border Grid.Row="4" Background="{StaticResource Surface}">
            <TabControl x:Name="ResultTabs" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Border}" Padding="0" Background="{StaticResource Surface}">
              <TabItem x:Name="ResultTab">
                <TabItem.Header>
                  <TextBlock x:Name="ResultTabHeader" Text="Result"/>
                </TabItem.Header>
                <Grid>
                  <DataGrid x:Name="ResultGrid" AutoGenerateColumns="True" IsReadOnly="False" CanUserAddRows="False"/>
                  <StackPanel x:Name="ResultEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE9D2;" FontSize="26" Foreground="#C9CFD8" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ResultEmptyText" Text="Run a query to see rows here" Style="{StaticResource MutedText}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Grid>
              </TabItem>
              <TabItem>
                <TabItem.Header>
                  <TextBlock x:Name="OutputTabHeader" Text="Output"/>
                </TabItem.Header>
                <DataGrid x:Name="OutputGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="FullRow">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="34">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Brush}" FontSize="12" VerticalAlignment="Center"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="#" Binding="{Binding No}" Width="40"/>
                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="80"/>
                    <DataGridTextColumn Header="Statement" Binding="{Binding Action}" Width="2*"/>
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="3*"/>
                    <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="80"/>
                  </DataGrid.Columns>
                </DataGrid>
              </TabItem>
            </TabControl>
          </Border>
        </Grid>
      </Grid>

      <!-- ================= PAGE: DOCTOR ================= -->
      <ScrollViewer x:Name="PageDoctor" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel Margin="24">
          <Border Style="{StaticResource Card}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryBtn}" Content="Run all checks" Click="RunChecks_Click"/>
                <Button x:Name="DoctorFixAllBtn" Style="{StaticResource PrimaryBtn}" Content="Fix all safely" Margin="8,0,0,0" Click="FixAll_Click"/>
              </StackPanel>
              <TextBlock x:Name="DoctorSummaryIcon" Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="26" Foreground="{StaticResource Warn}"/>
              <StackPanel Margin="14,0,0,0">
                <TextBlock x:Name="DoctorSummaryTitle" Text="2 problems, 1 warning, 5 OK" Style="{StaticResource H1}" FontSize="18"/>
                <TextBlock Text="Doctor checks the things that usually break XAMPP/WAMP and fixes them. A backup is always taken before any repair." Style="{StaticResource MutedText}"/>
              </StackPanel>
            </DockPanel>
          </Border>

          <ItemsControl x:Name="ChecksList" Margin="0,12,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" Padding="16,12">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryBtn}" Content="{Binding FixLabel}" Visibility="{Binding FixVisibility}"
                            VerticalAlignment="Center" Click="CheckFix_Click" Tag="{Binding}"/>
                    <Border Width="34" Height="34" CornerRadius="17" Background="{Binding SoftBrush}" VerticalAlignment="Top">
                      <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Brush}" FontSize="14"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,16,0" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
                        <Border Background="{Binding SoftBrush}" CornerRadius="8" Padding="7,1" Margin="8,0,0,0">
                          <TextBlock Text="{Binding StatusText}" Foreground="{Binding Brush}" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <!-- ================= PAGE: BACKUPS ================= -->
      <ScrollViewer x:Name="PageBackups" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel Margin="24">
          <Border Style="{StaticResource Card}">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryBtn}" Content="Backup now" VerticalAlignment="Center" Click="BackupNow_Click"/>
              <StackPanel>
                <TextBlock Text="Automatic backups are on" Style="{StaticResource H2}"/>
                <TextBlock Text="Every 30 minutes, before every DROP / DELETE-all / repair, and when you close the app. Keeps the last 20." Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource Card}" Padding="0" Margin="0,12,0,0">
            <DataGrid x:Name="BackupGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionUnit="FullRow" MaxHeight="520">
              <DataGrid.Columns>
                <DataGridTextColumn Header="When" Binding="{Binding When}" Width="1.3*"/>
                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="2*"/>
                <DataGridTextColumn Header="Databases" Binding="{Binding Dbs}" Width="1.3*"/>
                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="*"/>
                <DataGridTemplateColumn Header="" Width="110">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource SecondaryBtn}" Content="Restore" Padding="10,2" FontSize="12" Click="Restore_Click" Tag="{Binding}"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ================= PAGE: SETTINGS ================= -->
      <ScrollViewer x:Name="PageSettings" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel Margin="24" MaxWidth="760" HorizontalAlignment="Left">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Server" Style="{StaticResource H2}" Margin="0,0,0,10"/>
              <CheckBox Content="Pick a free port automatically if 3306 is busy" IsChecked="True" Margin="0,4"/>
              <CheckBox Content="Start the server when LuminaDB opens" IsChecked="True" Margin="0,4"/>
              <CheckBox Content="Shut the server down cleanly when LuminaDB closes" IsChecked="True" Margin="0,4"/>
              <CheckBox Content="Only allow connections from this PC (127.0.0.1)" IsChecked="True" Margin="0,4"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="Safety" Style="{StaticResource H2}" Margin="0,0,0,10"/>
              <CheckBox Content="Safe updates: confirm UPDATE / DELETE without WHERE" IsChecked="True" Margin="0,4"/>
              <CheckBox Content="Take a snapshot before DROP and TRUNCATE (enables Undo)" IsChecked="True" Margin="0,4"/>
              <CheckBox Content="Explain errors in plain English with a suggested fix" IsChecked="True" Margin="0,4"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="Data folder" Style="{StaticResource H2}"/>
              <TextBlock Text="D:\LuminaDB\data" FontFamily="Consolas" FontSize="12" Margin="0,8,0,0"/>
              <TextBlock Text="Moving it is safe: LuminaDB stops the server, copies, verifies, then restarts." Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- ================= CONFIRM DIALOG OVERLAY ================= -->
    <Grid x:Name="ConfirmOverlay" Grid.ColumnSpan="2" Background="#99101828" Visibility="Collapsed">
      <Border Background="{StaticResource Surface}" CornerRadius="10" Width="480" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource WarnSoft}">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource Warn}" HorizontalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="ConfirmTitle" Text="This will change every row" Style="{StaticResource H2}" FontSize="16" Margin="12,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="ConfirmMessage" Style="{StaticResource MutedText}" FontSize="13" Margin="0,14,0,0"
                     Text="Your DELETE has no WHERE, so it removes all 12 rows from students."/>
          <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,12,0,0">
            <TextBlock x:Name="ConfirmSql" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Text="DELETE FROM students;"/>
          </Border>
          <TextBlock Text="A snapshot is taken first, so Undo can bring the rows back." Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource SecondaryBtn}" Content="Cancel" Click="ConfirmCancel_Click"/>
            <Button x:Name="ConfirmAltBtn" Style="{StaticResource SecondaryBtn}" Content="Add WHERE for me" Margin="8,0,0,0" Click="ConfirmAlt_Click"/>
            <Button Style="{StaticResource DangerBtn}" Content="Run anyway" Margin="8,0,0,0" Click="ConfirmRun_Click"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ================= TOAST ================= -->
    <Border x:Name="Toast" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24"
            Background="#101828" CornerRadius="8" Padding="14,10" Visibility="Collapsed" MaxWidth="420">
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="ToastIcon" Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="#4ADE80" FontSize="13"/>
        <TextBlock x:Name="ToastText" Text="Done" Foreground="White" Margin="10,0,0,0" FontSize="12" TextWrapping="Wrap" MaxWidth="360"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
